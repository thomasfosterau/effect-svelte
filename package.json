{
  "name": "@thomasfosterau/effect-svelte",
  "version": "0.0.0",
  "description": "A library for working with Svelte, SvelteKit and Effect",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "effect",
    "svelte",
    "sveltekit",
    "typescript",
    "functional-programming"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-svelte.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-svelte/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-svelte#readme",
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "effect": "^3.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@sveltejs/kit": "^2.0.0",
    "effect": "^3.0.0",
    "typescript": "^5.3.3"
  }
}
