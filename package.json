{
  "name": "effect-svelte-workspace",
  "private": true,
  "description": "Monorepo workspace for Effect integrations with Svelte and SvelteKit",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/svelte",
    "packages/svelte-kit"
  ],
  "scripts": {
    "build": "bunx nx run-many -t build --all",
    "build:affected": "bunx nx affected -t build",
    "clean": "bunx nx run-many -t clean --all",
    "prepare": "effect-language-service patch",
    "typecheck": "bunx nx run-many -t typecheck --all",
    "typecheck:affected": "bunx nx affected -t typecheck",
    "ci:affected": "bunx nx affected -t typecheck,build --parallel=3",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@effect/experimental": "^0.58.0",
    "@effect/language-service": "^0.85.1",
    "@effect/platform": "^0.94.0",
    "@sveltejs/kit": "^2.0.0",
    "effect": "^3.0.0",
    "nx": "^20.3.3",
    "svelte": "^5.0.0",
    "typescript": "^5.3.3"
  }
}
