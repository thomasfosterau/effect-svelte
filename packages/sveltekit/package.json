{
  "name": "@thomasfosterau/effect-sveltekit",
  "version": "0.6.0",
  "description": "Effect integration for SvelteKit: load/action/endpoint wrappers, remote functions, an effectKit() Vite plugin, and an Effect HTTP deployment adapter",
  "keywords": [
    "effect",
    "functional-programming",
    "svelte",
    "sveltekit",
    "typescript",
    "vite-plugin"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-svelte/tree/trunk/packages/sveltekit#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-svelte/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-svelte.git",
    "directory": "packages/sveltekit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./adapter/handler": {
      "types": "./dist/adapter/handler.d.ts",
      "import": "./dist/adapter/handler.js"
    },
    "./adapter/serve": {
      "types": "./dist/adapter/serve.d.ts",
      "import": "./dist/adapter/serve.js"
    },
    "./internal/auto": {
      "types": "./dist/internal/auto.d.ts",
      "import": "./dist/internal/auto.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:unit": "vp test run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@thomasfosterau/effect-svelte": "workspace:^",
    "magic-string": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:peers",
    "@sveltejs/kit": "catalog:peers",
    "effect": "catalog:peers",
    "svelte": "catalog:peers",
    "vite": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.17"
  }
}
