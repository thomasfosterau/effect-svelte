{
	"name": "@thomasfosterau/effect-svelte-kit",
	"version": "0.0.0",
	"description": "SvelteKit integration for Effect",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"prepublishOnly": "npm run clean && npm run build",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"keywords": [
		"effect",
		"sveltekit",
		"typescript",
		"functional-programming"
	],
	"author": "Thomas Foster",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/thomasfosterau/effect-svelte.git",
		"directory": "packages/svelte-kit"
	},
	"bugs": {
		"url": "https://github.com/thomasfosterau/effect-svelte/issues"
	},
	"homepage": "https://github.com/thomasfosterau/effect-svelte#readme",
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@effect/platform": "^0.94.0",
		"@sveltejs/kit": "^2.0.0",
		"effect": "^3.0.0"
	}
}