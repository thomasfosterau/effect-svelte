{
	"name": "effect-svelte",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"root": "packages/svelte",
	"sourceRoot": "packages/svelte/src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bun run build",
				"cwd": "packages/svelte"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bun run typecheck",
				"cwd": "packages/svelte"
			}
		},
		"clean": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bun run clean",
				"cwd": "packages/svelte"
			}
		}
	}
}