{
  "name": "example-hacker-news",
  "version": "0.0.0",
  "private": true,
  "description": "Hacker News reader built with SvelteKit, Effect, and @thomasfosterau/effect-svelte",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "node build/index.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@thomasfosterau/effect-svelte": "workspace:*",
    "@thomasfosterau/effect-sveltekit": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
